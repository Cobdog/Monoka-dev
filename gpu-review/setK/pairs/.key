# Set K review-pair key - ESCROWED. Do not open until your calls are
# recorded (export review-responses.js from review.html?set=K first).

- pair: p01 [null]
  L: nullK  R: tween01
  contrast: NULL GATE: tween step 1 duplicated through the __setKnull VAE alias

- pair: p02 [k1-primary]
  L: fl2va_fill  R: tween_fill
  contrast: K1: the tween-chain fill vs the FL2VA guide-timeline fill of the same beat

- pair: p03 [k1-primary]
  L: tween_fill  R: latent_fill
  contrast: K1: the tween-chain fill vs the latent-chain fill of the same beat

- pair: p04 [k1-primary]
  L: fl2va_fill  R: latent_fill
  contrast: K1: the FL2VA-guide fill vs the latent-chain fill

- pair: p05 [k2-dial]
  L: dial_h  R: dial_q
  contrast: K2 DIAL: 'landing a quarter' vs 'landing half'

- pair: p06 [k2-dial]
  L: dial_m  R: dial_h
  contrast: K2 DIAL: 'landing half' vs 'landing most'

- pair: p07 [k2-drift]
  L: drift_hold  R: drift_approach
  contrast: K2 DRIFT: chain steps 1-5 (approach) vs 6-10 (post-arrival hold)

- pair: p08 [context]
  L: tween01  R: hero
  contrast: CONTEXT: the hero one-shot whole-beat bridge vs tween step 1 (the first fifth)

